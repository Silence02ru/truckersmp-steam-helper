<div class="profile_customization">
  <div class="profile_customization_header">
    <img src="{{ iconURL }}" width="16px" alt="Logo">
    {{#if blocked}}TruckersMP data is unavailable{{else}}No TruckersMP account ¯\_(ツ)_/¯{{/if}}
  </div>
  <div class="profile_customization_block tmp_block">
    {{#if blocked}}
      <div class="customtext_showcase">
        <div class="showcase_content_bg showcase_notes">
          TruckersMP API blocks requests from the extension (Cloudflare check).
          Set an API proxy in the extension options
          ({{#if reason}}{{ reason }}{{else}}no proxy configured{{/if}}).
        </div>
      </div>
    {{/if}}
    <div class="customtext_showcase">
      <div class="showcase_content_bg showcase_stats_row">
        {{#if count}}
          <div class="showcase_stat">
            <div class="label">ETS2</div>
            <div class="value">
              {{#ifEquals ets2 -1}}
                Not found
              {{else}}
                {{ ets2 }} h
              {{/ifEquals}}
            </div>
          </div>
        {{/if}}

        {{#if count}}
          <div class="showcase_stat">
            <div class="label">ATS</div>
            <div class="value">
              {{#ifEquals ats -1}}
                Not found
              {{else}}
                {{ ats }} h
              {{/ifEquals}}
            </div>
          </div>
        {{/if}}

        {{#if count}}
        {{else}}
          <div class="showcase_stat">
            <div class="label">Game Details</div>
            <div class="value">
              Private
            </div>
          </div>
        {{/if}}

        <div class="showcase_stat">
          <div class="label">Playtime</div>
          <div class="value">
            {{#if count}}
              {{#ifEquals all -1}}
                Private
              {{else}}
                Public
              {{/ifEquals}}
            {{else}}
              Private?
            {{/if}}
          </div>
        </div>
        <div style="clear: left;"></div>
      </div>
    </div>
  </div>
</div>
